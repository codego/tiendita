# Contact form destination until Con pinta has its own inbox.
CONTACT_TO=joacoditoma@gmail.com

# Public origin for Open Graph / WhatsApp previews (absolute image URLs).
# Local: http://localhost:3000 — set this to the real host (e.g. https://conpinta.com) when you share.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Web Push for the 20:55 ping when the PWA is closed.
# Generate with: npx web-push generate-vapid-keys
# Leave empty — the first-time sheet + local 20:55 scheduler still work.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:joacoditoma@gmail.com
